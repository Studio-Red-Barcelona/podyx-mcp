# Create a studio key in Podyx Settings → API keys. Never commit your real key.
PODYX_API_KEY=YOUR_PODYX_API_KEY
PODYX_ENABLE_WRITES=false
# Only for HTTP mode. Generate a DIFFERENT random value with at least 32 chars.
# PODYX_MCP_TOKEN=
# PORT=3333
# Containers only; ordinary local HTTP keeps 127.0.0.1 by default:
# PODYX_HTTP_HOST=0.0.0.0
# PODYX_ALLOWED_HOSTS=localhost,127.0.0.1,your-exact-tunnel-host.example
# Optional dedicated Podyx test environment, HTTPS origin only:
# PODYX_BASE_URL=https://your-test-environment.example
